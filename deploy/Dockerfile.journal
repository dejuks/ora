FROM node:22-bookworm-slim
WORKDIR /app
COPY services/journal-service/package*.json ./
RUN npm ci --no-audit --no-fund
COPY services/journal-service/tsconfig.json ./
COPY services/journal-service/src ./src
COPY services/journal-service/scripts ./scripts
RUN npm run build && mkdir -p /data/uploads
ENV NODE_ENV=production
EXPOSE 4001
CMD ["node", "dist/server.js"]
