# ORA Authentication Service - copy to .env and fill in real values.
APP_NAME="ORA Authentication Service"
NODE_ENV=development
PORT=4000

# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB in the ROOT .env
DATABASE_URL="postgresql://ora_app:change_this_local_password@127.0.0.1:5433/ora_platform"

# JWT (HS256). Minimum 32 characters. Share with other ORA services
# that need to verify access tokens.
ACCESS_TOKEN_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_OF_32_CHARS_OR_MORE
ACCESS_TOKEN_EXPIRES_IN=15m

# Refresh token / session lifetime (SRS: 7 days).
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
# Lifetime when "Remember me" is ticked.
REMEMBER_ME_REFRESH_TOKEN_EXPIRES_IN_DAYS=30

FRONTEND_URL=http://localhost:3000

# Seed (super admin)
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# ---- E-mail (development: Mailpit from compose.yaml) ----
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ORA Platform <no-reply@ora.local>"

# ---- Account security (defaults shown) ----
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
EMAIL_VERIFICATION_EXPIRES_IN_HOURS=24
PASSWORD_RESET_EXPIRES_IN_MINUTES=60
# Set to 1 when running behind a reverse proxy
# TRUST_PROXY=1
