{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "Authentication and User Management microservice for the Oromo Research Association Digital Platform.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "tsx src/modules/auth/password.test.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:seed": "tsx prisma/seed.ts",
    "test:smoke": "node tests/auth.smoke.mjs",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate || echo \"WARNING: prisma generate failed. Run: npx prisma generate\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
