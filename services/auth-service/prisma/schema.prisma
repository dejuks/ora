generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "iam", "security"]
}

model email_verification_tokens {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  token_hash  String    @unique
  expires_at  DateTime  @db.Timestamptz(6)
  verified_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_email_verification_user")
  @@schema("auth")
}

model password_reset_tokens {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_password_reset_user")
  @@schema("auth")
}

model refresh_tokens {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id           String           @db.Uuid
  token_hash           String           @unique
  expires_at           DateTime         @db.Timestamptz(6)
  revoked_at           DateTime?        @db.Timestamptz(6)
  replaced_by_token_id String?          @db.Uuid
  created_at           DateTime         @default(now()) @db.Timestamptz(6)
  refresh_tokens       refresh_tokens?  @relation("refresh_tokensTorefresh_tokens", fields: [replaced_by_token_id], references: [id], onUpdate: NoAction)
  other_refresh_tokens refresh_tokens[] @relation("refresh_tokensTorefresh_tokens")
  user_sessions        user_sessions    @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([session_id], map: "idx_refresh_tokens_session")
  @@schema("auth")
}

model user_credentials {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String    @unique @db.Uuid
  password_hash        String
  password_changed_at  DateTime? @db.Timestamptz(6)
  must_change_password Boolean   @default(false)
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @default(now()) @db.Timestamptz(6)
  users                users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("auth")
}

model user_invitations {
  id                                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                  String    @db.Uuid
  email                                    String    @db.VarChar(255)
  token_hash                               String    @unique
  invited_by                               String?   @db.Uuid
  expires_at                               DateTime  @db.Timestamptz(6)
  accepted_at                              DateTime? @db.Timestamptz(6)
  revoked_at                               DateTime? @db.Timestamptz(6)
  created_at                               DateTime  @default(now()) @db.Timestamptz(6)
  users_user_invitations_invited_byTousers users?    @relation("user_invitations_invited_byTousers", fields: [invited_by], references: [id], onUpdate: NoAction)
  users_user_invitations_user_idTousers    users     @relation("user_invitations_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_invitations_user")
  @@schema("auth")
}

model user_sessions {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String           @db.Uuid
  device_name      String?          @db.VarChar(150)
  device_type      String?          @db.VarChar(50)
  ip_address       String?          @db.Inet
  user_agent       String?
  last_activity_at DateTime         @default(now()) @db.Timestamptz(6)
  expires_at       DateTime         @db.Timestamptz(6)
  revoked_at       DateTime?        @db.Timestamptz(6)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  refresh_tokens   refresh_tokens[]
  users            users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "idx_sessions_expiry")
  @@index([user_id], map: "idx_sessions_user")
  @@schema("auth")
}

model library_branches {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String                    @unique @db.VarChar(150)
  description             String?
  is_active               Boolean                   @default(true)
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                  @default(now()) @db.Timestamptz(6)
  user_module_assignments user_module_assignments[]

  @@schema("iam")
}

model modules {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                    String                    @unique @db.VarChar(30)
  name                    String                    @db.VarChar(150)
  description             String?
  is_active               Boolean                   @default(true)
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                  @default(now()) @db.Timestamptz(6)
  permissions             permissions[]
  roles                   roles[]
  user_module_assignments user_module_assignments[]

  @@schema("iam")
}

model permissions {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module_id        String?            @db.Uuid
  name             String             @db.VarChar(150)
  code             String             @unique @db.VarChar(150)
  resource         String             @db.VarChar(100)
  action           String             @db.VarChar(50)
  description      String?
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  modules          modules?           @relation(fields: [module_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  role_permissions role_permissions[]

  @@index([module_id], map: "idx_permissions_module")
  @@schema("iam")
}

model role_permissions {
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_id])
  @@schema("iam")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model roles {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module_id         String?             @db.Uuid
  name              String              @db.VarChar(100)
  code              String              @unique(map: "uq_system_role_code", where: raw("((scope)::text = 'SYSTEM'::text)")) @db.VarChar(100)
  scope             String              @db.VarChar(20)
  description       String?
  is_system_role    Boolean             @default(false)
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  role_permissions  role_permissions[]
  modules           modules?            @relation(fields: [module_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user_module_roles user_module_roles[]
  user_system_roles user_system_roles[]

  @@unique([module_id, code], map: "uq_module_role_code", where: raw("((scope)::text = 'MODULE'::text)"))
  @@unique([id, module_id], map: "uq_roles_id_module")
  @@index([module_id], map: "idx_roles_module")
  @@schema("iam")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model user_module_assignments {
  id                                               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                          String              @db.Uuid
  module_id                                        String              @db.Uuid
  library_branch_id                                String?             @db.Uuid
  assigned_by                                      String?             @db.Uuid
  status                                           String              @default("ACTIVE") @db.VarChar(20)
  assigned_at                                      DateTime            @default(now()) @db.Timestamptz(6)
  expires_at                                       DateTime?           @db.Timestamptz(6)
  created_at                                       DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                                       DateTime            @default(now()) @db.Timestamptz(6)
  users_user_module_assignments_assigned_byTousers users?              @relation("user_module_assignments_assigned_byTousers", fields: [assigned_by], references: [id], onUpdate: NoAction)
  library_branches                                 library_branches?   @relation(fields: [library_branch_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  modules                                          modules             @relation(fields: [module_id], references: [id], onUpdate: NoAction)
  users_user_module_assignments_user_idTousers     users               @relation("user_module_assignments_user_idTousers", fields: [user_id], references: [id], onUpdate: NoAction)
  user_module_roles                                user_module_roles[]

  @@unique([id, module_id], map: "uq_assignment_id_module")
  @@unique([user_id, module_id], map: "uq_user_module")
  @@index([module_id], map: "idx_user_module_module")
  @@index([status], map: "idx_user_module_status")
  @@index([user_id], map: "idx_user_module_user")
  @@schema("iam")
}

model user_module_roles {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module_assignment_id    String                  @db.Uuid
  module_id               String                  @db.Uuid
  role_id                 String                  @db.Uuid
  assigned_by             String?                 @db.Uuid
  assigned_at             DateTime                @default(now()) @db.Timestamptz(6)
  expires_at              DateTime?               @db.Timestamptz(6)
  created_at              DateTime                @default(now()) @db.Timestamptz(6)
  roles                   roles                   @relation(fields: [role_id, module_id], references: [id, module_id], onUpdate: NoAction, map: "fk_user_module_role")
  user_module_assignments user_module_assignments @relation(fields: [module_assignment_id, module_id], references: [id, module_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_module_role_assignment")
  users                   users?                  @relation(fields: [assigned_by], references: [id], onUpdate: NoAction)

  @@unique([module_assignment_id, role_id], map: "uq_module_assignment_role")
  @@schema("iam")
}

model user_profiles {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String   @unique @db.Uuid
  profile_photo_url String?
  job_title         String?  @db.VarChar(150)
  organization      String?  @db.VarChar(200)
  bio               String?
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)
  users             users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("iam")
}

model user_system_roles {
  id                                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                    String    @db.Uuid
  role_id                                    String    @db.Uuid
  assigned_by                                String?   @db.Uuid
  assigned_at                                DateTime  @default(now()) @db.Timestamptz(6)
  expires_at                                 DateTime? @db.Timestamptz(6)
  created_at                                 DateTime  @default(now()) @db.Timestamptz(6)
  users_user_system_roles_assigned_byTousers users?    @relation("user_system_roles_assigned_byTousers", fields: [assigned_by], references: [id], onUpdate: NoAction)
  roles                                      roles     @relation(fields: [role_id], references: [id], onUpdate: NoAction)
  users_user_system_roles_user_idTousers     users     @relation("user_system_roles_user_idTousers", fields: [user_id], references: [id], onUpdate: NoAction)

  @@unique([user_id, role_id], map: "uq_user_system_role")
  @@index([user_id], map: "idx_user_system_roles_user")
  @@schema("iam")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model users {
  id                                                                 String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  first_name                                                         String                      @db.VarChar(100)
  last_name                                                          String                      @db.VarChar(100)
  username                                                           String                      @db.VarChar(100)
  email                                                              String                      @db.VarChar(255)
  status                                                             String                      @default("PENDING") @db.VarChar(20)
  email_verified_at                                                  DateTime?                   @db.Timestamptz(6)
  last_login_at                                                      DateTime?                   @db.Timestamptz(6)
  created_at                                                         DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                                                         DateTime                    @default(now()) @db.Timestamptz(6)
  deleted_at                                                         DateTime?                   @db.Timestamptz(6)
  email_verification_tokens                                          email_verification_tokens[]
  password_reset_tokens                                              password_reset_tokens[]
  user_credentials                                                   user_credentials?
  user_invitations_user_invitations_invited_byTousers                user_invitations[]          @relation("user_invitations_invited_byTousers")
  user_invitations_user_invitations_user_idTousers                   user_invitations[]          @relation("user_invitations_user_idTousers")
  user_sessions                                                      user_sessions[]
  user_module_assignments_user_module_assignments_assigned_byTousers user_module_assignments[]   @relation("user_module_assignments_assigned_byTousers")
  user_module_assignments_user_module_assignments_user_idTousers     user_module_assignments[]   @relation("user_module_assignments_user_idTousers")
  user_module_roles                                                  user_module_roles[]
  user_profiles                                                      user_profiles?
  user_system_roles_user_system_roles_assigned_byTousers             user_system_roles[]         @relation("user_system_roles_assigned_byTousers")
  user_system_roles_user_system_roles_user_idTousers                 user_system_roles[]         @relation("user_system_roles_user_idTousers")
  audit_logs                                                         audit_logs[]
  login_attempts                                                     login_attempts[]
  security_events                                                    security_events[]

  @@index([created_at(sort: Desc)], map: "idx_users_created_at")
  @@index([status], map: "idx_users_status")
  @@schema("iam")
}

model audit_logs {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_user_id String?  @db.Uuid
  action        String   @db.VarChar(150)
  entity_type   String   @db.VarChar(100)
  entity_id     String?  @db.Uuid
  old_values    Json?
  new_values    Json?
  ip_address    String?  @db.Inet
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  users         users?   @relation(fields: [actor_user_id], references: [id], onUpdate: NoAction)

  @@index([actor_user_id, created_at(sort: Desc)], map: "idx_audit_actor")
  @@index([created_at(sort: Desc)], map: "idx_audit_created")
  @@index([entity_type, entity_id], map: "idx_audit_entity")
  @@schema("security")
}

model login_attempts {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String?  @db.Uuid
  identifier     String   @db.VarChar(255)
  ip_address     String?  @db.Inet
  user_agent     String?
  success        Boolean
  failure_reason String?  @db.VarChar(100)
  attempted_at   DateTime @default(now()) @db.Timestamptz(6)
  users          users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([identifier, attempted_at(sort: Desc)], map: "idx_login_attempts_identifier")
  @@index([user_id, attempted_at(sort: Desc)], map: "idx_login_attempts_user")
  @@schema("security")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model security_events {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?  @db.Uuid
  event_type  String   @db.VarChar(100)
  severity    String   @default("INFO") @db.VarChar(20)
  description String?
  metadata    Json?
  ip_address  String?  @db.Inet
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([severity, created_at(sort: Desc)], map: "idx_security_events_severity")
  @@index([user_id, created_at(sort: Desc)], map: "idx_security_events_user")
  @@schema("security")
}
