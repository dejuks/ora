APP_NAME="ORA Journal Service"
NODE_ENV=development
PORT=4001

# Same database the auth service uses (schema "jms").
DATABASE_URL="postgresql://ora_app:change_this_local_password@127.0.0.1:5433/ora_platform"

# MUST be identical to ACCESS_TOKEN_SECRET in services/auth-service/.env
ACCESS_TOKEN_SECRET=replace_with_the_same_secret_as_the_auth_service

FRONTEND_URL=http://localhost:3000

# Uploaded manuscripts / proofs are stored here (relative to this folder).
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Mailpit (development mail catcher, inbox: http://localhost:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="ORA Journals <no-reply@ora.local>"
